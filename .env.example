# Copy this file to .env and replace every change-me value.
# Never commit the resulting .env file.

# Application databases
USER_DB_PASSWORD=change-me-user-db-password
DICTIONARY_DB_PASSWORD=change-me-dictionary-db-password
NOTIFICATION_DB_PASSWORD=change-me-notification-db-password
PROFILES_DB_PASSWORD=change-me-profiles-db-password
ORDERS_DB_PASSWORD=change-me-orders-db-password

# Redis cache
REDIS_PASSWORD=change-me-redis-password

# MinIO object storage
MINIO_ROOT_USER=bounty-minio-admin
MINIO_ROOT_PASSWORD=change-me-minio-root-password
MINIO_APP_ACCESS_KEY=bounty-media-service
MINIO_APP_SECRET_KEY=change-me-minio-app-secret-key

# Grafana local administrator
GRAFANA_ADMIN_PASSWORD=change-me-grafana-admin-password

# Logging
LOG_ENVIRONMENT=docker
ROOT_LOG_LEVEL=INFO
DICTIONARY_LOG_LEVEL=INFO
SPRING_LOG_LEVEL=WARN
HIBERNATE_SQL_LOG_LEVEL=WARN
HIBERNATE_BIND_LOG_LEVEL=WARN

# Keycloak
KEYCLOAK_DB_PASSWORD=change-me-keycloak-db-password
KEYCLOAK_ADMIN_PASSWORD=change-me-keycloak-admin-password
KEYCLOAK_USER_SERVICE_CLIENT_SECRET=change-me-keycloak-user-service-client-secret

# Shared service-to-service authentication token
APP_INTERNAL_AUTH_TOKEN=change-me-to-a-long-random-internal-token

# Base64-encoded random value containing at least 32 bytes for HS256.
# Generate one in PowerShell:
# [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(48))
APP_SECURITY_JWT_SECRET=Y2hhbmdlLW1lLXRvLWEtcmFuZG9tLTMyLWJ5dGUtc2VjcmV0ISE=
